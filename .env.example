# Server
PORT=3000
NODE_ENV=development
# Comma-separated origins; `*` wildcards allowed.
# Vercel: host must start with product-checkout-fe and end with .vercel.app
# (CORS Origin has no path — only scheme + host + port).
CORS_ORIGIN=http://localhost:5173,https://product-checkout-fe*.vercel.app

# Shared secret for API access (send as header x-api-key). Generate your own UUID.
API_KEY=00000000-0000-4000-8000-000000000000

# Supabase Postgres (connection string from project settings)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Payment provider (sandbox) — never commit real secrets
PAYMENT_API_URL=https://api-sandbox.example.com/v1
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_INTEGRITY_KEY=
PAYMENT_EVENTS_KEY=

# Checkout fees (COP, numeric 12,2). Source of truth for totals.
BASE_FEE=3500.00
DELIVERY_FEE=10000.00
CURRENCY=COP
